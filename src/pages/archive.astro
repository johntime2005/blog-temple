---
import ArchivePanel from "@components/controls/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getArchivePagePostsList } from "@/utils/content-utils";

const sortedPostsList = await getArchivePagePostsList();

const minimalPostsList = sortedPostsList.map((post) => ({
	id: post.id,
	data: {
		title: post.data.title,
		tags: post.data.tags,
		category: post.data.category || undefined,
		published: post.data.published,
	},
}));
---

<MainGridLayout title={i18n(I18nKey.archive)}>
	<script is:inline>
		(function () {
			var p = new URLSearchParams(location.search);
			var cat = p.get("category") || "";
			var tag = p.get("tag") || "";
			var unc = p.get("uncategorized");
			var t = cat || (unc ? "未分类" : "") || (tag ? "#" + tag : "");
			if (t) {
				requestAnimationFrame(function () {
					var el = document.querySelector(".banner-page-title-text");
					if (el) el.textContent = t;
				});
			}
		})();
	</script>
	<ArchivePanel sortedPosts={minimalPostsList} client:only="svelte" />
</MainGridLayout>
